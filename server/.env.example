# PostgreSQL connection settings for local development
# Copy this file to .env and adjust values as needed

PGHOST=localhost
PGPORT=5432
PGDATABASE=as500
PGUSER=as500
PGPASSWORD=as500

# Alternatively, use DATABASE_URL (takes precedence if set)
# DATABASE_URL=postgres://as500:as500@localhost:5432/as500

# Jira integration (optional — used by Time Registration task lookup)
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_USER_EMAIL=you@example.com
# JIRA_API_TOKEN=your-api-token

# as500-docs RAG service (optional)
# DOCS_API_URL=http://host.docker.internal:8080
# DOCS_MIN_SCORE=0.25   (chunks below this relevance score are ignored)
