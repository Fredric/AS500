{
  "name": "as500-server",
  "version": "1.0.0",
  "description": "AS500 Terminal Server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "dev:debug": "tsx watch --inspect=0.0.0.0:9230 --env-file=.env.local src/index.ts",
    "build": "npx tsc && npx shx mkdir -p dist/core/db && npx shx cp -r src/core/db/migrations dist/core/db/migrations",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/db/migrate.ts",
    "tsc": "npx tsc",
    "typecheck": "npx tsc --noEmit",
    "start": "node --env-file=.env.local dist/index.js",
    "seed": "npx tsx src/core/db/seed.ts",
    "export-data": "tsx scripts/export-sqlite.ts",
    "import-data": "tsx scripts/import-postgres.ts",
    "migrate-data": "npm run export-data && npm run import-data",
    "backup-db": "tsx scripts/backup-database.ts",
    "restore-db": "tsx scripts/restore-database.ts",
    "push-to-heroku": "tsx scripts/push-to-heroku.ts",
    "audit": "node scripts/audit.mjs",
    "audit:tail": "node scripts/audit.mjs --tail"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.2",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "pg": "^8.13.0",
    "typescript": "^5.9.3",
    "uuid": "^11.0.4",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2"
  }
}
